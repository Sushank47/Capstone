# ==========================================
# MediExplain AI Environment Configuration
# ==========================================

# App & Auth Settings
APP_NAME="MediExplain AI"
ENVIRONMENT="production"
PORT=8000
SECRET_KEY="mediexplain-super-secret-key-production-change-me-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Database URL
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="mediexplain_db"

# Azure Blob Storage (Connection String or leave blank for local file fallback)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="medical-documents"

# Azure AI Vision (Form Recognizer / Document Intelligence OCR)
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# Azure AI Language (Text Analytics for Health)
AZURE_LANGUAGE_ENDPOINT=""
AZURE_LANGUAGE_KEY=""

# Azure OpenAI (GPT-4 Summarization & Comparison)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Azure AI Search (Vector RAG Indexing)
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_KEY=""
AZURE_SEARCH_INDEX_NAME="medical-reports-index"

# Azure AI Speech (Text-To-Speech & Speech-To-Text)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"
